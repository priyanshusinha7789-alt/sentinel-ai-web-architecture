# SENTINEL AI Web Environment Variables Template
# Copy this file to .env.local to configure local development keys
# DO NOT commit real API keys or secrets to version control

# VirusTotal API v3 Key (Optional)
# Enables live multi-engine URL reputation scanning in the analyzer and threat-intel modules.
# Obtain a free public tier API key at: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Google Gemini API Key (Optional)
# Enables AI-assisted educational explanations of detected threat dossiers.
# Obtain a key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
